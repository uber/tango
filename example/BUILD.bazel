load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "example_lib",
    srcs = ["main.go"],
    importpath = "github.com/uber/tango/example",
    visibility = ["//visibility:private"],
    deps = [
        "//config",
        "//core/git",
        "//core/storage",
        "//core/storage/disk",
        "//module",
        "//tangopb",
        "@org_uber_go_fx//:fx",
        "@org_uber_go_yarpc//:yarpc",
        "@org_uber_go_yarpc//api/transport",
        "@org_uber_go_yarpc//transport/grpc",
        "@org_uber_go_zap//:zap",
    ],
)

go_binary(
    name = "example",
    data = [":config"],
    embed = [":example_lib"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "config",
    srcs = glob(["*.yaml"]),
    visibility = ["//visibility:public"],
)
